---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedDevlogs } from "../utils/devlogs";
import { developers } from "../data/developers";
import { formatDateCompact } from "../utils/format";

const devlogs = await getPublishedDevlogs();
const [featured, ...archive] = devlogs;

const byline = (slug: string) => developers.find((d) => d.slug === slug)?.name ?? slug;
---

<BaseLayout
  title="OKTANT — Devlogs"
  description="The public engineering devlogs for Oktant."
  path="/"
>
  <main class="landing container">
    {
      featured && (
        <section class="featured-section" aria-labelledby="latest-title">
          <a class="featured-card" href={`/devlogs/${featured.id}/`}>
            <div class="featured-meta">
              <span>{formatDateCompact(featured.data.date)}</span>
              <span>{byline(featured.data.author)}</span>
            </div>
            <h2 id="latest-title">{featured.data.title}</h2>
            <span class="read-link">Read dev_log <span aria-hidden="true">↗</span></span>
          </a>
        </section>
      )
    }

    {
      archive.length > 0 && (
        <section class="archive-section">
          <ul class="devlog-list">
            {archive.map((entry) => (
              <li>
                <a class="devlog-row" href={`/devlogs/${entry.id}/`}>
                  <span class="row-date">{formatDateCompact(entry.data.date)}</span>
                  <span class="row-title">{entry.data.title}</span>
                  <span class="row-author">{byline(entry.data.author)}</span>
                  <span class="row-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .eyebrow,
  .section-label,
  .section-count,
  .featured-meta,
  .row-date,
  .row-author {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-count,
  .row-date,
  .row-author {
    color: var(--ink-faint);
  }

  .landing {
    padding-bottom: 6rem;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .section-rule {
    height: 1px;
    flex: 1;
    background: var(--line);
  }

  .section-label {
    color: var(--ink);
    font-weight: 650;
  }

  .featured-card {
    display: block;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--ink);
    color: var(--bg);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .featured-card:hover {
    background: var(--accent);
    transform: translateY(-3px);
  }

  .featured-meta {
    display: flex;
    gap: 1.25rem;
    color: var(--bg);
    opacity: 0.65;
  }

  .featured-card h2 {
    max-width: 20ch;
    margin-top: 2.75rem;
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    letter-spacing: -0.045em;
  }

  .read-link {
    display: inline-block;
    margin-top: 3rem;
    font-size: 0.8125rem;
    font-weight: 650;
  }

  .read-link span {
    margin-left: 0.35rem;
  }

  .archive-section {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .devlog-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .devlog-row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 7rem 1rem;
    gap: 1rem;
    align-items: baseline;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s ease;
  }

  .devlog-row:hover {
    color: var(--accent);
  }

  .row-title {
    font-weight: 600;
  }

  .row-arrow {
    text-align: right;
    color: var(--ink-faint);
  }

  @media (max-width: 650px) {
    .site-header {
      padding-block: 1.1rem;
    }

    .devlog-row {
      grid-template-columns: 1fr 1rem;
      gap: 0.4rem 1rem;
    }

    .row-title {
      grid-column: 1;
      grid-row: 1;
    }

    .row-date,
    .row-author {
      grid-row: 2;
    }

    .row-date {
      grid-column: 1;
    }

    .row-author {
      grid-column: 1;
      margin-left: 5.25rem;
    }

    .row-arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
