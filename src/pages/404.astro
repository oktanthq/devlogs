---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — OKTANT" description="Page not found." path="/404/">
  <section class="not-found container">
    <p class="error-code mono">404</p>
    <h1>Not found</h1>
    <a class="home-link" href="/">Back to dev_logs <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    padding-block: clamp(4rem, 12vw, 8rem) var(--space-8);
  }

  .error-code {
    color: var(--accent);
    font-size: clamp(6rem, 18vw, 12rem);
    font-weight: 500;
    letter-spacing: -0.09em;
    line-height: 0.85;
  }

  .not-found h1 {
    margin-top: 1.5rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 550;
    letter-spacing: -0.05em;
  }

  .home-link {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .home-link:hover {
    color: var(--accent);
  }
</style>
