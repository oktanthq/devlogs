---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — OKTANT" description="Page not found." path="/404/">
  <section class="not-found container-narrow">
    <h1>404</h1>
    <p>
      <a class="link" href="/">Devlogs →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-9) var(--space-8);
  }

  .not-found h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
  }

  .not-found p {
    margin-top: var(--space-5);
  }
</style>